@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the home page

class HomePage {
  +services: ServiceSummary[]
  +skipToContent(): void
  +startProject(): void
}
class ServiceSummary <<data>> {
  +title: string
  +body: string
}
class SkipLink {
  +label: input<string>
  +activated: output<void>
}
class SiteHeader {
  +ctaLabel: input<string>
  +ctaActivated: output<void>
}
class Hero {
  +heading: input<string>
}
class VideoPlayer {
  +src: input<string>
  +poster: input<string>
  +captionsSrc: input<string>
  +label: input<string>
}
class ServiceCard {
  +title: input<string>
  +body: input<string>
}
class ProductSummary <<data>> {
  +title: string
  +body: string
}
class ProcessStepSummary <<data>> {
  +name: string
  +summary: string
  +practices: string
}
class Question <<data>> {
  +question: string
  +answer: string
}
class ProductCard {
  +status: input<string>
  +heading: input<string>
  +body: input<string>
}
class ProcessStep {
  +number: input<number>
  +name: input<string>
  +summary: input<string>
  +practices: input<string>
}
class Disclosure {
  +summary: input<string>
  +body: input<string>
}
class SiteFooter {
  +year: input<number>
  +location: input<string>
  +email: input<string>
}
class ContactForm {
  +focusEmail(): void
}
class SecurityHeadersMiddleware {
  +InvokeAsync(context: HttpContext): Task
}
class SameOriginMiddleware {
  +InvokeAsync(context: HttpContext): Task
}
HomePage *-- "1" SkipLink
HomePage *-- "1" SiteHeader
HomePage *-- "1" Hero
HomePage *-- "1" VideoPlayer
HomePage *-- "2" ServiceCard
HomePage *-- "1" ContactForm
HomePage *-- "1" ProductCard
HomePage *-- "4" ProcessStep
HomePage *-- "6" Disclosure
HomePage *-- "1" SiteFooter
HomePage --> "2" ServiceSummary
HomePage --> "1" ProductSummary
HomePage --> "4" ProcessStepSummary
HomePage --> "6" Question
HomePage ..> ContactForm : startProject() calls focusEmail()
@enduml
