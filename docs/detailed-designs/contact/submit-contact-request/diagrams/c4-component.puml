@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Submit a contact request

Container_Boundary(spa, "Goodwork web app") {
  Component(form, "ContactForm", "domain library component", "Form, validation, sending, sent and error states")
  Component(contract, "IContactRequestService / CONTACT_REQUEST_SERVICE", "api library contract and token", "Submit contract")
  Component(svc, "ContactRequestService", "api library HTTP adapter", "POST /api/contact-requests")
  Component(ui, "TextField, Alert, Button, Card", "components library", "Presentational controls")
}
Container_Boundary(api, "Goodwork API") {
  Component(limiter, "Contact rate limiter", "ASP.NET Core rate limiting", "5 requests per 10 minutes per client address")
  Component(ctrl, "ContactRequestsController", "ASP.NET Core controller", "Anonymous POST /api/contact-requests, 16 KB limit")
  Component(behavior, "ValidationBehavior", "MediatR pipeline behavior", "Runs validators, throws ValidationException")
  Component(validator, "SubmitContactRequestCommandValidator", "FluentValidation", "Email and message rules")
  Component(problems, "ValidationExceptionHandler, StorageExceptionHandler", "IExceptionHandler", "400 with field errors, 503")
  Component(handler, "SubmitContactRequestCommandHandler", "MediatR handler", "Discards honeypot hits, stores the request")
  Component(entity, "ContactRequest", "Domain entity", "Email, message, received time, delivery status")
  ComponentDb(db, "Goodwork database", "SQLite via EF Core", "ContactRequests table")
}
Rel(form, ui, "Composes")
Rel(form, contract, "inject(CONTACT_REQUEST_SERVICE)")
Rel(svc, contract, "Implements")
Rel(svc, limiter, "POST", "JSON/HTTPS")
Rel(limiter, ctrl, "Admits")
Rel(ctrl, behavior, "Sends SubmitContactRequestCommand", "MediatR")
Rel(behavior, validator, "Validates with")
Rel(behavior, handler, "Passes valid commands to")
Rel(problems, ctrl, "Turns thrown exceptions into responses for")
Rel(handler, entity, "Creates")
Rel(handler, db, "Saves", "EF Core")
@enduml
