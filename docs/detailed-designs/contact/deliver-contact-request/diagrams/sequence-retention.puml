@startuml
title UML sequence behaviour — Delete expired contact requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Goodwork API application" #D1FADF
  participant "ContactRequestRetentionWorker" as worker
end box
box "Backend — Goodwork Application and Domain" #ECFDF3
  participant "DeleteExpiredContactRequestsCommandHandler" as handler
end box
box "Backend — Goodwork Infrastructure" #FFF4E5
  database "Goodwork database" as db
end box
worker -> handler : Send DeleteExpiredContactRequestsCommand once a day
handler -> handler : cutoff = now minus 24 months
handler -> db : Delete ContactRequests where ReceivedAt < cutoff (L2-011)
db --> handler : Rows deleted
handler -> handler : Log count only
handler --> worker : Number deleted
@enduml
