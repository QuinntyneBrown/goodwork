@startuml
title UML sequence behaviour — Delete expired contact requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Goodwork API application" #D1FADF
  participant "ContactRequestRetentionWorker" as worker
end box
box "Backend — Goodwork Infrastructure" #FFF4E5
  database "Goodwork database" as db
end box
worker -> worker : Wait for daily run; cutoff = now minus 24 months
worker -> db : Delete ContactRequests where ReceivedAt < cutoff (L2-011)
db --> worker : Rows deleted
worker -> worker : Log count only
@enduml
